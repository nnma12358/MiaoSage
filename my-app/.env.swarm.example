# ============================================================
# 苗绣·识裳 — Swarm 分布式环境变量
# ============================================================
# 用法：复制此文件为 .env.swarm 并修改 PC_IP
#   cp .env.swarm.example .env.swarm
#
# K1 启动：
#   docker compose -f docker-compose.swarm.yml --profile k1 up -d --build
#
# PC 启动：
#   docker compose -f docker-compose.swarm.yml --profile pc up -d --build
#
# 全部启动：
#   docker compose -f docker-compose.swarm.yml --profile all up -d --build
# ============================================================

# ---- 网络 ----
# PC 的 IP 地址（K1 网关需要访问 PC 上的 ASR/TTS 服务）
PC_IP=192.168.1.100

# ---- Ollama（K1 宿主机） ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-instruct

# ---- YOLO（K1） ----
YOLO_MODEL=yolov8n.onnx
OMP_NUM_THREADS=4

# ---- Whisper ASR（PC） ----
# 模型大小: tiny(1GB) / base(1.5GB) / small(2.5GB)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=zh

# ---- TTS（PC） ----
# edge-tts: 微软免费，需联网，中文音质极佳
# piper:    离线运行，需预下载模型
TTS_BACKEND=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_MAX_LEN=300

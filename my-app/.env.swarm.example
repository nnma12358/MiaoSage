# ============================================================
# 苗绣·识裳 — Swarm 分布式环境变量
# ============================================================
# 用法：复制此文件为 .env.swarm 并修改 PC_IP
#   cp .env.swarm.example .env.swarm
#
# K1 启动（Gateway + YOLO + ASR）：
#   docker compose -f docker-compose.swarm.yml --profile k1 up -d --build
#
# PC 启动（仅 TTS）：
#   docker compose -f docker-compose.swarm.yml --profile pc up -d --build
# ============================================================

# ---- 网络 ----
# PC 的 IP 地址（K1 网关需要访问 PC 上的 TTS 服务）
PC_IP=192.168.1.100

# ---- Ollama（K1 宿主机） ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-instruct

# ---- YOLO（K1） ----
YOLO_MODEL=yolov8n.onnx
OMP_NUM_THREADS=4

# ---- TTS（PC · MeloTTS 本地推理） ----
# MeloTTS: 开源高音质中文 TTS，CPU 推理，无需联网
# 模型首次启动自动下载到 /app/models
TTS_LANGUAGE=ZH
TTS_SPEAKER=0
TTS_SPEED=1.0
TTS_MAX_LEN=300
TTS_VOICE=zh_CN-huayan-medium
TTS_MAX_LEN=300

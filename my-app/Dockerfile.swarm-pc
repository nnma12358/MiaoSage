# ============================================================
# 苗绣·识裳 — PC 端 TTS（edge-tts · 零 apt · 纯 pip）
# ============================================================
# edge-tts 调用微软免费 TTS API，音质最佳，中文自然。
# 纯 pip 安装，无需 apt-get，无需下载模型，构建极快。
#
# 构建 & 运行：
#   docker build -f Dockerfile.swarm-pc -t miao-sage:swarm-pc .
#   docker run -d --name miao-tts-pc -p 8002:8002 miao-sage:swarm-pc
# ============================================================
FROM python:3.11-slim-bookworm

WORKDIR /app

# ---- pip 阿里云镜像加速（edge-tts 纯 Python，无 C 编译） ----
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir \
    edge-tts \
    fastapi uvicorn \
    python-multipart \
    && rm -rf /root/.cache/pip/*

# ---- 服务代码 ----
COPY server/tts_pc.py /app/

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health')" || exit 1

EXPOSE 8002

CMD ["python3", "tts_pc.py"]

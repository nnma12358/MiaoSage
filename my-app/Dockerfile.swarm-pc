# ============================================================
# 苗绣·识裳 — PC 端 TTS 服务（x86_64）
# ============================================================
# 将 TTS 从 K1 板卸载到 PC，释放 K1 ~1.5GB 内存给 Ollama。
# 默认 edge-tts（微软免费），也可设 TTS_BACKEND=piper 离线运行。
#
# 构建：
#   docker build -f Dockerfile.swarm-pc -t miao-sage:swarm-pc .
#
# 运行：
#   docker run -d --name miao-tts-pc --network host \
#     -e TTS_BACKEND=edge-tts miao-sage:swarm-pc
# ============================================================
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Python 依赖 ----
RUN pip install --no-cache-dir \
    edge-tts \
    fastapi uvicorn \
    python-multipart \
    && rm -rf /root/.cache/pip/*

# ---- 服务代码 ----
COPY server/tts_pc.py /app/

# ---- 健康检查 ----
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

EXPOSE 8002

CMD ["python3", "tts_pc.py"]

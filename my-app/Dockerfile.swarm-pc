# ============================================================
# 苗绣·识裳 — PC 端 TTS（MeloTTS 容器化）
# ============================================================
# MeloTTS: 开源高音质中文 TTS，本地 CPU 推理，无需联网。
# 模型首次启动时自动下载到 /app/models。
#
# 构建 & 运行：
#   docker build -f Dockerfile.swarm-pc -t miao-sage:swarm-pc .
#   docker run -d --name miao-tts-pc -p 8002:8002 -v melo-models:/app/models miao-sage:swarm-pc
# ============================================================
FROM python:3.11-slim-bookworm

WORKDIR /app

# ---- 系统依赖 + 国内 Debian 镜像加速 ----
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# ---- pip 安装（阿里云镜像加速 torch，保持层缓存） ----
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir torchaudio --extra-index-url https://download.pytorch.org/whl/cpu \
    && rm -rf /root/.cache/pip/*
# 若 torch 下载超时，可先手动 docker pull 或使用预构建层

# ---- MeloTTS 本地安装（预装缺失依赖，再装本地包） ----
COPY MeloTTS/ /app/MeloTTS/
# 清华镜像装 MeloTTS，再补 torchaudio CUDA 运行时兼容
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/ && \
    pip install --no-cache-dir nvidia-cuda-runtime-cu12 && \
    pip install --no-cache-dir /app/MeloTTS/ && \
    ln -sf /usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib/libcudart.so.12 \
           /usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib/libcudart.so.13 && \
    pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir fastapi uvicorn python-multipart && \
    rm -rf /root/.cache/pip/*
# GPU 版本: 将 torch[cpu] 替换为 torch torchaudio --index-url https://download.pytorch.org/whl/cu121

# ---- 模型缓存目录 ----
RUN mkdir -p /app/models
ENV MELO_MODEL_DIR=/app/models
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/torch/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib

# ---- 服务代码 ----
COPY server/tts_pc.py /app/

HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health')" || exit 1

EXPOSE 8002

CMD ["python3", "tts_pc.py"]
